{
  "name": "automacao-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test Tests/OpenApiSchema.spec.ts Tests/ContractIntegrity.spec.ts",
    "test:gets": "playwright test --grep @get --grep-invert @pending",
    "test:negativos": "playwright test --grep @negative",
    "test:mutacoes": "playwright test --grep @mutation",
    "report": "npm run report:generate && npm run report:open",
    "report:generate": "node -e \"require('fs').rmSync('allure-report',{recursive:true,force:true})\" && allure generate allure-results -o allure-report",
    "report:open": "allure open allure-report",
    "report:clear": "node -e \"const fs=require('fs'); for (const dir of ['allure-report','allure-results']) { fs.rmSync(dir,{recursive:true,force:true}); fs.mkdirSync(dir,{recursive:true}); }\"",
    "test:har": "npm run test:gets",
    "har:import": "node Scripts/import-hars.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure": "^3.20.1",
    "allure-playwright": "^3.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
